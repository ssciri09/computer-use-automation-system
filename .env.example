# Discovery (the LLM-driven recording pass) needs a model key:
ANTHROPIC_API_KEY=sk-ant-...

# Sign-on credentials for the target app, resolved via the artifact's
# credentials ref (env://CUA). These are the mock app's published test
# credentials — never real ones. Values are registered with the redactor
# and can never appear in logs, transcripts, or artifacts.
CUA_USERNAME=operator
CUA_PASSWORD=letmein

# Optional: override the discovery model (default claude-opus-5)
# CUA_MODEL=claude-opus-5
